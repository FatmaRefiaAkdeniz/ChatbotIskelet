# =============================================================================
#  API ANAHTARLARI
#  1) Bu dosyanın bir kopyasını ".env" adıyla oluşturun:   cp .env.example .env
#  2) Aşağıda KULLANDIĞINIZ sağlayıcıyı seçip anahtarını yapıştırın.
#  3) Sunucuyu başlatın:   npm start
#
#  .env dosyası gizlidir: Git'e eklemeyin, kimseyle paylaşmayın.
# =============================================================================

# --- 1) Sağlayıcı ------------------------------------------------------------
# Şunlardan birini yazın:
#
#   openai      https://platform.openai.com/api-keys       (görsel + PDF okur)
#   anthropic   https://console.anthropic.com/settings/keys (görsel + PDF okur)
#   gemini      https://aistudio.google.com/apikey         (görsel + PDF okur, ücretsiz kota var)
#   deepseek    https://platform.deepseek.com/api_keys     (yalnızca metin, çok ucuz)
#   groq        https://console.groq.com/keys              (yalnızca metin, çok hızlı)
#   openrouter  https://openrouter.ai/keys                 (tek anahtarla birçok model)
#   mistral     https://console.mistral.ai/api-keys        (yalnızca metin)
#   ollama      Kendi bilgisayarınızda çalışan model; anahtar gerekmez
#   ozel        OpenAI uyumlu başka bir servis (AI_BASE_URL zorunlu)
AI_PROVIDER=openai

# --- 2) Anahtar ---------------------------------------------------------------
AI_API_KEY=

# --- 3) Model (isteğe bağlı) --------------------------------------------------
# Boş bırakırsanız sağlayıcının varsayılanı kullanılır:
#   openai: gpt-4o-mini · anthropic: claude-haiku-4-5 · gemini: gemini-3.6-flash
#   deepseek: deepseek-chat · groq: llama-3.3-70b-versatile · mistral: mistral-small-latest
#   openrouter: openai/gpt-4o-mini · ollama: llama3.1
# Model adları zamanla değişir; "model bulunamadı" hatası alırsanız sağlayıcının
# sitesindeki güncel adı buraya yazın.
AI_MODEL=

# --- 4) Adres (yalnızca "ozel" ve "ollama" için) -------------------------------
# Örnek: https://api.ornek.com/v1   ·   Ollama için boş bırakın (http://localhost:11434/v1)
AI_BASE_URL=

# --- Sunucu -------------------------------------------------------------------
# Boş bırakılırsa 3000.
PORT=

# Sunucu Nginx, Cloudflare, Render gibi bir vekilin arkasındaysa 1 yapın; hız sınırı
# ziyaretçinin gerçek IP adresine göre çalışır.
TRUST_PROXY=0
